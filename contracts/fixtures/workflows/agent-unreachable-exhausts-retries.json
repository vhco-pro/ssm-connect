{
  "schemaVersion": 1,
  "id": "agent-unreachable-exhausts-retries",
  "title": "An agent that never answers warns, keeps the tunnel up, and leaks nothing",
  "covers": [
    "Agent provisioning failure",
    "The transient agent tunnel is always torn down"
  ],
  "profile": {
    "$ref": "../profiles/multi-user.json"
  },
  "given": {
    "ports": {
      "AuthProvider": {
        "authenticate": [
          {
            "result": {
              "source": "cache",
              "interactive": false
            }
          }
        ]
      },
      "EC2Provider": {
        "resolveInstance": [
          {
            "result": {
              "id": "i-0bbbbbbbbbbbbbbb2",
              "state": "running"
            }
          }
        ]
      },
      "SSMProvider": {
        "waitForSSMOnline": [
          {
            "result": null
          }
        ],
        "startSession": [
          {
            "result": {
              "sessionId": "example-session-0040"
            }
          },
          {
            "result": {
              "sessionId": "example-agent-session-0040"
            }
          }
        ]
      },
      "TunnelProvider": {
        "startTunnel": [
          {
            "result": {
              "processIdentifier": 4310
            }
          },
          {
            "result": {
              "processIdentifier": 4311
            }
          }
        ]
      },
      "ReadinessProbe": {
        "waitUntilReady": [
          {
            "result": true
          }
        ]
      },
      "IdentityProvider": {
        "resolveIdentity": [
          {
            "result": {
              "username": "example.user"
            }
          }
        ],
        "presignedIdentityToken": [
          {
            "result": "synthetic-presigned-token"
          }
        ]
      },
      "AgentClient": {
        "ensureSession": [
          {
            "error": {
              "kind": "agentUnreachable",
              "message": "connection refused"
            }
          }
        ]
      },
      "DCVLauncher": {
        "launch": [
          {
            "result": null
          }
        ]
      }
    }
  },
  "when": [
    {
      "action": "connect"
    }
  ],
  "expect": {
    "states": [
      "authenticating",
      "resolving",
      "waitingForSSM",
      "tunneling",
      "connected"
    ],
    "calls": [
      {
        "port": "TunnelProvider",
        "method": "terminateTunnel",
        "times": 1
      }
    ],
    "forbiddenCalls": [
      {
        "port": "DCVLauncher",
        "method": "launch"
      },
      {
        "port": "SecretsProvider",
        "method": "fetchSecret"
      }
    ],
    "terminal": {
      "state": "connected",
      "errorCategory": "none",
      "warningPresent": true,
      "tunnelActive": true,
      "passwordInMemory": false
    }
  }
}
