{
  "schemaVersion": 1,
  "id": "orphaned-session-is-reaped-before-connecting",
  "title": "Sessions a previous run left open are terminated before a new tunnel is opened",
  "covers": [
    "Abnormal exit does not leak an AWS-side session",
    "Local process containment is not sufficient on its own"
  ],
  "profile": {
    "$ref": "../profiles/single-user.json"
  },
  "given": {
    "ports": {
      "AuthProvider": {
        "authenticate": [
          {
            "result": {
              "source": "cache",
              "interactive": false
            }
          }
        ]
      },
      "EC2Provider": {
        "resolveInstance": [
          {
            "result": {
              "id": "i-0aaaaaaaaaaaaaaa1",
              "state": "running"
            }
          }
        ]
      },
      "SSMProvider": {
        "waitForSSMOnline": [
          {
            "result": null
          }
        ],
        "reapOrphanedSessions": [
          {
            "result": 1
          }
        ],
        "startSession": [
          {
            "result": {
              "sessionId": "example-session-0060"
            }
          }
        ]
      },
      "TunnelProvider": {
        "startTunnel": [
          {
            "result": {
              "processIdentifier": 4400
            }
          }
        ]
      },
      "ReadinessProbe": {
        "waitUntilReady": [
          {
            "result": true
          }
        ]
      },
      "SecretsProvider": {
        "fetchSecret": [
          {
            "result": "synthetic-dcv-password"
          }
        ]
      },
      "DCVLauncher": {
        "launch": [
          {
            "result": null
          }
        ]
      }
    }
  },
  "when": [
    {
      "action": "connect"
    }
  ],
  "expect": {
    "states": [
      "authenticating",
      "resolving",
      "waitingForSSM",
      "tunneling",
      "connected"
    ],
    "calls": [
      {
        "port": "SSMProvider",
        "method": "waitForSSMOnline",
        "times": 1
      },
      {
        "port": "SSMProvider",
        "method": "reapOrphanedSessions",
        "times": 1,
        "with": {
          "instanceId": "i-0aaaaaaaaaaaaaaa1"
        }
      },
      {
        "port": "SSMProvider",
        "method": "startSession",
        "times": 1
      },
      {
        "port": "TunnelProvider",
        "method": "startTunnel",
        "times": 1
      }
    ],
    "terminal": {
      "state": "connected",
      "errorCategory": "none",
      "tunnelActive": true
    }
  }
}
