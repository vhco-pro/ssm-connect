{
  "schemaVersion": 1,
  "id": "agent-unreachable-retries-then-succeeds",
  "title": "A transport failure while the agent tunnel settles is retried, not surfaced",
  "covers": [
    "Agent provisioning",
    "Transient agent transport failures are retried"
  ],
  "profile": {
    "$ref": "../profiles/multi-user.json"
  },
  "given": {
    "ports": {
      "AuthProvider": {
        "authenticate": [
          {
            "result": {
              "source": "cache",
              "interactive": false
            }
          }
        ]
      },
      "EC2Provider": {
        "resolveInstance": [
          {
            "result": {
              "id": "i-0bbbbbbbbbbbbbbb2",
              "state": "running"
            }
          }
        ]
      },
      "SSMProvider": {
        "waitForSSMOnline": [
          {
            "result": null
          }
        ],
        "startSession": [
          {
            "result": {
              "sessionId": "example-session-0040"
            }
          },
          {
            "result": {
              "sessionId": "example-agent-session-0040"
            }
          }
        ]
      },
      "TunnelProvider": {
        "startTunnel": [
          {
            "result": {
              "processIdentifier": 4310
            }
          },
          {
            "result": {
              "processIdentifier": 4311
            }
          }
        ]
      },
      "ReadinessProbe": {
        "waitUntilReady": [
          {
            "result": true
          }
        ]
      },
      "IdentityProvider": {
        "resolveIdentity": [
          {
            "result": {
              "username": "example.user"
            }
          }
        ],
        "presignedIdentityToken": [
          {
            "result": "synthetic-presigned-token-1"
          },
          {
            "result": "synthetic-presigned-token-2"
          },
          {
            "result": "synthetic-presigned-token-3"
          }
        ]
      },
      "AgentClient": {
        "ensureSession": [
          {
            "error": {
              "kind": "agentUnreachable",
              "message": "connection refused"
            }
          },
          {
            "result": {
              "user": "example.user",
              "sessionId": "example.user-session"
            }
          }
        ]
      },
      "DCVLauncher": {
        "launch": [
          {
            "result": null
          }
        ]
      }
    }
  },
  "when": [
    {
      "action": "connect"
    }
  ],
  "expect": {
    "states": [
      "authenticating",
      "resolving",
      "waitingForSSM",
      "tunneling",
      "connected"
    ],
    "calls": [
      {
        "port": "AgentClient",
        "method": "ensureSession",
        "times": 2
      },
      {
        "port": "IdentityProvider",
        "method": "presignedIdentityToken",
        "times": 3
      },
      {
        "port": "TunnelProvider",
        "method": "terminateTunnel",
        "times": 1
      },
      {
        "port": "DCVLauncher",
        "method": "launch",
        "times": 1
      }
    ],
    "terminal": {
      "state": "connected",
      "errorCategory": "none",
      "warningPresent": false,
      "tunnelActive": true,
      "passwordInMemory": false
    }
  }
}
