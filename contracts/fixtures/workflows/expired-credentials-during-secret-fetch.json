{
  "schemaVersion": 1,
  "id": "expired-credentials-during-secret-fetch",
  "title": "Expired SSO credentials during the DCV secret fetch re-authenticate and retry in place",
  "covers": [
    "Expired credentials during an AWS stage",
    "Recovery re-authenticates without tearing down the flow or returning to the authenticating state"
  ],
  "profile": {
    "$ref": "../profiles/single-user.json"
  },
  "given": {
    "ports": {
      "AuthProvider": {
        "authenticate": [
          {
            "result": {
              "source": "cache",
              "interactive": false
            }
          },
          {
            "result": {
              "source": "deviceAuthorization",
              "interactive": true
            }
          }
        ]
      },
      "EC2Provider": {
        "resolveInstance": [
          {
            "result": {
              "id": "i-0aaaaaaaaaaaaaaa1",
              "state": "running"
            }
          }
        ]
      },
      "SSMProvider": {
        "waitForSSMOnline": [
          {
            "result": null
          }
        ],
        "startSession": [
          {
            "result": {
              "sessionId": "example-session-0013"
            }
          }
        ]
      },
      "TunnelProvider": {
        "startTunnel": [
          {
            "result": {
              "processIdentifier": 4255
            }
          }
        ]
      },
      "ReadinessProbe": {
        "waitUntilReady": [
          {
            "result": true
          }
        ]
      },
      "SecretsProvider": {
        "fetchSecret": [
          {
            "error": {
              "kind": "expiredCredentials"
            }
          },
          {
            "result": "synthetic-dcv-password"
          }
        ]
      },
      "DCVLauncher": {
        "launch": [
          {
            "result": null
          }
        ]
      }
    }
  },
  "when": [
    {
      "action": "connect"
    }
  ],
  "expect": {
    "states": [
      "authenticating",
      "resolving",
      "waitingForSSM",
      "tunneling",
      "connected"
    ],
    "calls": [
      {
        "port": "AuthProvider",
        "method": "authenticate",
        "times": 2
      },
      {
        "port": "SecretsProvider",
        "method": "fetchSecret",
        "times": 2
      }
    ],
    "terminal": {
      "state": "connected",
      "errorCategory": "none",
      "warningPresent": false,
      "tunnelActive": true
    }
  }
}
