{
  "schemaVersion": 1,
  "id": "instance-replacement-resets-stale-tunnel-state",
  "title": "A rebuilt workstation resets stale tunnel state before connecting",
  "covers": [
    "Workstation instance replacement"
  ],
  "profile": {
    "$ref": "../profiles/single-user.json"
  },
  "given": {
    "lastInstanceId": "i-0999999999999999f",
    "ports": {
      "AuthProvider": {
        "authenticate": [
          {
            "result": {
              "source": "cache",
              "interactive": false
            }
          }
        ]
      },
      "EC2Provider": {
        "resolveInstance": [
          {
            "result": {
              "id": "i-0aaaaaaaaaaaaaaa1",
              "state": "running"
            }
          }
        ]
      },
      "SSMProvider": {
        "waitForSSMOnline": [
          {
            "result": null
          }
        ],
        "startSession": [
          {
            "result": {
              "sessionId": "example-session-0020"
            }
          }
        ]
      },
      "TunnelProvider": {
        "startTunnel": [
          {
            "result": {
              "processIdentifier": 4260
            }
          }
        ]
      },
      "ReadinessProbe": {
        "waitUntilReady": [
          {
            "result": true
          }
        ]
      },
      "SecretsProvider": {
        "fetchSecret": [
          {
            "result": "synthetic-dcv-password"
          }
        ]
      },
      "DCVLauncher": {
        "launch": [
          {
            "result": null
          }
        ]
      }
    }
  },
  "when": [
    {
      "action": "connect"
    }
  ],
  "expect": {
    "states": [
      "authenticating",
      "resolving",
      "waitingForSSM",
      "tunneling",
      "connected"
    ],
    "calls": [
      {
        "port": "InstanceIdStore",
        "method": "lastInstanceId",
        "times": 1
      },
      {
        "port": "InstanceIdStore",
        "method": "setLastInstanceId",
        "times": 1,
        "with": {
          "instanceId": "i-0aaaaaaaaaaaaaaa1"
        }
      }
    ],
    "terminal": {
      "state": "connected",
      "errorCategory": "none",
      "instanceId": "i-0aaaaaaaaaaaaaaa1",
      "tunnelActive": true
    }
  }
}
