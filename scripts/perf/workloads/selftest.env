# Self-test workload for scripts/perf/measure.sh: a fake app with known delays,
# so the harness's timing, warm-up, median and sampling logic can be checked on
# any host without SSM Connect. Expected: startup_ms near 300, ui_ms near 100,
# cold_ms and warm_ms near 200, idle values present.

RUNS=3
SETTLE_SECONDS=1
IDLE_SAMPLES=2
SELFTEST_DIR=$(mktemp -d "${TMPDIR:-/tmp}/ssm-perf-selftest.XXXXXX")
trap 'quit; rm -rf "$SELFTEST_DIR"' EXIT

cat >"$SELFTEST_DIR/fake-app" <<'APP'
#!/usr/bin/env bash
dir=$1
sleep 0.3; touch "$dir/ready"
while :; do
  [ -f "$dir/ui" ] && { sleep 0.1; mv "$dir/ui" "$dir/ui.done"; }
  [ -f "$dir/connect" ] && { sleep 0.2; mv "$dir/connect" "$dir/connected"; }
  [ -f "$dir/disconnect" ] && { rm -f "$dir/connected" "$dir/disconnect"; }
  sleep 0.02
done
APP
chmod +x "$SELFTEST_DIR/fake-app"

app_pids() { pgrep -f "$SELFTEST_DIR/fake-app" || true; }
launch() { rm -f "$SELFTEST_DIR"/ready; nohup "$SELFTEST_DIR/fake-app" "$SELFTEST_DIR" >/dev/null 2>&1 & }
quit() { pkill -f "$SELFTEST_DIR/fake-app" 2>/dev/null || true; rm -f "$SELFTEST_DIR"/ready; }
ready() { [ -f "$SELFTEST_DIR/ready" ]; }
ui_command() { touch "$SELFTEST_DIR/ui"; }
ui_done() { [ -f "$SELFTEST_DIR/ui.done" ]; }
ui_reset() { rm -f "$SELFTEST_DIR/ui.done"; }
connect() { touch "$SELFTEST_DIR/connect"; }
connected() { [ -f "$SELFTEST_DIR/connected" ]; }
disconnect() { touch "$SELFTEST_DIR/disconnect"; }
disconnected() { [ ! -f "$SELFTEST_DIR/connected" ]; }
