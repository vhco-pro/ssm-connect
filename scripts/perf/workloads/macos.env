# macOS workload for scripts/perf/measure.sh: the installed SSM Connect app,
# driven through its menu bar extra. Works with the current release unchanged.
#
# Requirements on the measuring Mac (see README.md):
# - Xcode command line tools (swiftc) for the window probe below.
# - Accessibility permission for the process that runs this script, so System
#   Events can click the menu bar extra (ui, cold and warm metrics).
# - For cold and warm: a configured workstation profile that connects without an
#   interactive sign-in (a valid SSO session).
#
# Overrides: PERF_APP (app bundle path), PERF_CONNECT_ITEM (menu item title).

PERF_APP=${PERF_APP:-/Applications/SSMConnect.app}
PERF_PROCESS=$(basename "$PERF_APP" .app)
PERF_BUNDLE_ID=pro.vhco.ssm-connect
PERF_CONNECT_ITEM=${PERF_CONNECT_ITEM:-Connect}
PERF_TMP=$(mktemp -d "${TMPDIR:-/tmp}/ssm-perf.XXXXXX")

# Counts the windows a process owns at a window layer, without Screen Recording
# permission: owner PID and layer are always reported by CGWindowList.
cat >"$PERF_TMP/probe.swift" <<'SWIFT'
import CoreGraphics
import Foundation
let pid = Int32(CommandLine.arguments[1])!
let layer = Int(CommandLine.arguments[2])!
let windows = CGWindowListCopyWindowInfo([.optionAll], kCGNullWindowID) as? [[String: Any]] ?? []
print(windows.filter { ($0[kCGWindowOwnerPID as String] as? Int32) == pid && ($0[kCGWindowLayer as String] as? Int) == layer }.count)
SWIFT
swiftc -O "$PERF_TMP/probe.swift" -o "$PERF_TMP/probe" 2>/dev/null

# Status bar items live at kCGStatusWindowLevel (25); an open NSMenu at
# kCGPopUpMenuWindowLevel (101).
window_count() { local pid; pid=$(app_pids | head -1); [ -n "$pid" ] || { echo 0; return; }; "$PERF_TMP/probe" "$pid" "$1"; }

app_pids() { pgrep -x "$PERF_PROCESS" || true; }
app_version() { defaults read "$PERF_APP/Contents/Info" CFBundleShortVersionString; }

launch() { open -g "$PERF_APP"; }
quit() {
  osascript -e "tell application id \"$PERF_BUNDLE_ID\" to quit" >/dev/null 2>&1 || true
  local i; for i in $(seq 1 100); do [ -z "$(app_pids)" ] && return 0; sleep 0.1; done
  pkill -x "$PERF_PROCESS" || true
}
ready() { [ "$(window_count 25)" -gt 0 ]; }

click_extra() {
  osascript -e "tell application \"System Events\" to tell process \"$PERF_PROCESS\" to click menu bar item 1 of menu bar 2" >/dev/null
}
close_menu() { osascript -e 'tell application "System Events" to key code 53' >/dev/null; sleep 0.3; }

ui_command() { click_extra; }
ui_done() { [ "$(window_count 101)" -gt 0 ]; }
ui_reset() { close_menu; }

# Connection state comes from the app's unified log (ConnectionStateMachine logs
# "State: <old> → <new>" under subsystem pro.vhco.ssm-connect).
log stream --style compact --predicate "subsystem == \"$PERF_BUNDLE_ID\"" >"$PERF_TMP/app.log" 2>/dev/null &
PERF_LOG_PID=$!
disown "$PERF_LOG_PID"
trap 'kill "$PERF_LOG_PID" 2>/dev/null; rm -rf "$PERF_TMP"' EXIT
PERF_MARK=0
mark_log() { PERF_MARK=$(wc -l <"$PERF_TMP/app.log"); }
logged_since_mark() { tail -n +"$((PERF_MARK + 1))" "$PERF_TMP/app.log" | grep -q -- "$1"; }

click_item() {
  click_extra; sleep 0.3
  osascript -e "tell application \"System Events\" to tell process \"$PERF_PROCESS\" to click menu item \"$1\" of menu 1 of menu bar item 1 of menu bar 2" >/dev/null
}
connect() { mark_log; click_item "$PERF_CONNECT_ITEM"; }
connected() { logged_since_mark "→ connected"; }
disconnect() { mark_log; click_item "Disconnect"; }
disconnected() { logged_since_mark "→ disconnected"; }
