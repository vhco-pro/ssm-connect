<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SSMConnect.Domain.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The portable-profile round-trip runs against the real contract documents. -->
    <ContractsDirectory>$(MSBuildThisFileDirectory)../../../contracts</ContractsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SSMConnect.Domain\SSMConnect.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(ContractsDirectory)/fixtures/profiles/*.json"
             Link="contracts/fixtures/profiles/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <!-- Documents the other client actually exported, for the AC-03 crossing test. -->
    <Content Include="$(ContractsDirectory)/fixtures/exchange/*.json"
             Link="contracts/fixtures/exchange/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
