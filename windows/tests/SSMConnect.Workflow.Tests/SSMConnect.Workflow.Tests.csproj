<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SSMConnect.Workflow.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- The fixtures are the contract; the runner locates them relative to the repository root. -->
    <ContractsDirectory>$(MSBuildThisFileDirectory)..\..\..\contracts</ContractsDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SSMConnect.Workflow\SSMConnect.Workflow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="$(ContractsDirectory)\fixtures\**\*.json"
             Link="contracts\fixtures\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
