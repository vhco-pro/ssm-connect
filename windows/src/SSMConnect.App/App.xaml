<Application x:Class="SSMConnect.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <!-- No StartupUri: this is a notification-area application and has no main window.
       ShutdownMode is explicit so closing the settings window does not exit the app. -->
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFAFAFA" />
      <SolidColorBrush x:Key="MutedBrush" Color="#FF5A5A5A" />

      <Style TargetType="TextBlock" x:Key="FieldLabel">
        <Setter Property="Margin" Value="0,10,0,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      </Style>

      <Style TargetType="TextBox">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
      </Style>

      <Style TargetType="Button">
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="Margin" Value="6,0,0,0" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
