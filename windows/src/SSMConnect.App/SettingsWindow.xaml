<Window x:Class="SSMConnect.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSM Connect Settings"
        Width="720" Height="580" MinWidth="640" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

  <Grid Margin="16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0" Grid.Column="0" Margin="0,0,16,0">
      <TextBlock DockPanel.Dock="Top" Text="Workstations" FontWeight="SemiBold" Margin="0,0,0,6" />
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
        <Button x:Name="AddButton" Content="Add" Margin="0" Click="OnAdd" />
        <Button x:Name="RemoveButton" Content="Remove" Click="OnRemove" />
      </StackPanel>
      <ListBox x:Name="ProfileList" DisplayMemberPath="Name" SelectionChanged="OnProfileSelected" />
    </DockPanel>

    <ScrollViewer Grid.Row="0" Grid.Column="1" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="Editor" IsEnabled="False">
        <TextBlock Text="Connection profile" FontWeight="SemiBold" />

        <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="NameBox" AutomationProperties.Name="Display name" />

        <TextBlock Text="SSO start URL" Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="StartUrlBox" AutomationProperties.Name="SSO start URL" />

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="SSO region" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="SsoRegionBox" AutomationProperties.Name="SSO region" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Resource region" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="ResourceRegionBox" AutomationProperties.Name="Resource region" />
          </StackPanel>
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Account ID" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="AccountBox" AutomationProperties.Name="Account ID" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Role name" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="RoleBox" AutomationProperties.Name="Role name" />
          </StackPanel>
        </Grid>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Instance tag key" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TagKeyBox" AutomationProperties.Name="Instance tag key" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="Instance tag value" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TagValueBox" AutomationProperties.Name="Instance tag value" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Connection mode" Style="{StaticResource FieldLabel}" />
        <ComboBox x:Name="ModeBox" AutomationProperties.Name="Connection mode" SelectionChanged="OnModeChanged">
          <ComboBoxItem Content="Single user (shared account and password)" />
          <ComboBoxItem Content="Multi-user (your own AWS identity)" />
        </ComboBox>

        <StackPanel x:Name="SecretPanel">
          <TextBlock Text="Secrets Manager secret ID for the DCV password"
                     Style="{StaticResource FieldLabel}" />
          <TextBox x:Name="SecretBox" AutomationProperties.Name="Secret ID" />
        </StackPanel>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="Local port" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="LocalPortBox" AutomationProperties.Name="Local port" />
          </StackPanel>
          <StackPanel Grid.Column="1" Margin="4,0,4,0">
            <TextBlock Text="Remote port" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="RemotePortBox" AutomationProperties.Name="Remote port" />
          </StackPanel>
          <StackPanel Grid.Column="2" Margin="8,0,0,0">
            <TextBlock Text="Agent port" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="AgentPortBox" AutomationProperties.Name="Agent port" />
          </StackPanel>
        </Grid>

        <TextBlock Text="Application settings" FontWeight="SemiBold" Margin="0,20,0,4" />
        <CheckBox x:Name="AutoConnectBox" Content="Connect automatically at launch" Margin="0,4" />
        <CheckBox x:Name="AutoReconnectBox" Content="Reconnect automatically if the tunnel drops" Margin="0,4" />
        <TextBlock Text="Clear the copied password after (seconds, 0 disables)"
                   Style="{StaticResource FieldLabel}" />
        <TextBox x:Name="ClipboardSecondsBox" Width="80" HorizontalAlignment="Left"
                 AutomationProperties.Name="Clipboard auto-clear seconds" />

        <TextBlock x:Name="ValidationText" Foreground="#FFD13438" TextWrapping="Wrap" Margin="0,12,0,0" />
      </StackPanel>
    </ScrollViewer>

    <DockPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
        <Button x:Name="ImportButton" Content="Import…" Margin="0" Click="OnImport" />
        <Button x:Name="ExportButton" Content="Export…" Click="OnExport" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Close" Click="OnClose" />
        <Button x:Name="SaveButton" Content="Save" IsDefault="True" Click="OnSave" />
      </StackPanel>
    </DockPanel>
  </Grid>
</Window>
