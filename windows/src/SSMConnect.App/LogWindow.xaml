<Window x:Class="SSMConnect.App.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSM Connect Log"
        Width="820" Height="460" MinWidth="520" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">

  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" Margin="0,0,0,8" TextWrapping="Wrap"
               Foreground="{StaticResource MutedBrush}"
               Text="What the connection workflow reported. Nothing here contains credentials, tokens, or the DCV password." />

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <CheckBox x:Name="FollowBox" Content="Follow" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
      <Button Content="Copy" Click="OnCopy" Margin="0" />
      <Button Content="Clear" Click="OnClear" />
      <Button Content="Close" Click="OnClose" IsCancel="True" />
    </StackPanel>

    <!-- Read-only rather than a label: people need to select and paste a line into a ticket. -->
    <TextBox x:Name="LogText"
             IsReadOnly="True"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             VerticalScrollBarVisibility="Auto"
             HorizontalScrollBarVisibility="Auto"
             FontFamily="Cascadia Mono, Consolas, monospace"
             FontSize="12"
             AutomationProperties.Name="Connection log" />
  </DockPanel>
</Window>
